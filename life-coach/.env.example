# ---- Kanal ----------------------------------------------------------------
# console = Test im Terminal, telegram = echter Betrieb
CHANNEL=telegram
# Von @BotFather in Telegram (/newbot)
TELEGRAM_BOT_TOKEN=
# Leer lassen, Bot anschreiben -> er antwortet mit deiner Chat-ID -> hier eintragen
TELEGRAM_CHAT_ID=

# ---- Zeit & Daten -----------------------------------------------------------
TZ_NAME=Europe/Vienna
DB_PATH=data/coach.db

# ---- KI über die offizielle Claude Code CLI (Pro-Abo, kein API-Key) --------
LLM_BACKEND=claude
CLAUDE_BIN=claude
MODEL_CHEAP=haiku
MODEL_SMART=sonnet
MONTHLY_BUDGET_USD=20
# ab 95 % des Budgets nur noch Vorlagen statt KI
BUDGET_HARD_STOP=0.95

# ---- Check-ins (Uhrzeit=Name) -----------------------------------------------
CHECKINS=06:30=morgen,10:00=vormittag,13:00=mittag,18:00=bewegung,21:30=abend
# Diese kommen nur, wenn es etwas zu besprechen gibt (leer = alle immer)
OPTIONAL_CHECKINS=vormittag,mittag,bewegung
FOLLOWUP_MINUTES=30
WEEKLY_REVIEW=SUN 19:00

# ---- Ernährung (Startwerte, später per /ziel) --------------------------------
KCAL_TARGET=2200
PROTEIN_TARGET=150
